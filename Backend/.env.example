# ================================================================
# SMART CAFETERIA ORDERING SYSTEM
# BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE - no real secrets)
# ================================================================
# Copy to `.env` for local development, or set these values as
# environment variables / Render secret fields in production.
# NEVER commit real secrets.

# ================================================================
# APPLICATION
# ================================================================
NODE_ENV=development
PORT=5000
APP_NAME=Smart Cafeteria Ordering System
LOG_LEVEL=info

# ================================================================
# MONGODB ATLAS CONNECTION
# ================================================================
# REQUIRED in production. Must be your own Atlas connection string.
MONGODB_URI=your_mongodb_atlas_connection_string
# Optional alias (used if MONGODB_URI is not set):
# MONGO_URI=your_mongodb_atlas_connection_string

# ================================================================
# JWT AUTHENTICATION
# ================================================================
# REQUIRED in production. Use a long random string.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
# Optional alias (used if JWT_EXPIRES_IN is not set):
# JWT_EXPIRE=7d

# ================================================================
# CORS / FRONTEND
# ================================================================
# The origin(s) your deployed frontend is served from.
# Comma-separate multiple origins if needed.
FRONTEND_URL=http://localhost:5500
CORS_ORIGIN=http://localhost:5500

# ================================================================
# PUBLIC BACKEND URL (used to build Chapa callback URLs)
# ================================================================
# The public HTTPS URL of this backend, e.g. https://my-app.onrender.com
BACKEND_URL=http://localhost:5000
# Optional alias (used if BACKEND_URL is not set):
# PUBLIC_BACKEND_URL=https://my-app.onrender.com

# ================================================================
# CHAPA PAYMENT GATEWAY
# ================================================================
# Obtain keys from https://dashboard.chapa.co -> Profile -> API
CHAPA_PUBLIC_KEY=your_chapa_public_key
CHAPA_SECRET_KEY=your_chapa_secret_key
# Optional (placeholders currently, key is not referenced by the app logic)
# CHAPA_ENCRYPTION_KEY=your_chapa_encryption_key
# Webhook signing secret as configured in your Chapa dashboard
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_signing_secret
# Where Chapa sends async payment events (public HTTPS URL in production)
CHAPA_CALLBACK_URL=http://localhost:5000/api/v1/payments/webhooks/chapa
# Where the customer is redirected back after paying on Chapa
CHAPA_RETURN_URL=http://localhost:5500/Frontend/src/pages/customer/order-tracking.html

# ================================================================
# UPLOADS (optional, currently enforced inside src/config/multer.js)
# ================================================================
MAX_FILE_SIZE=5242880