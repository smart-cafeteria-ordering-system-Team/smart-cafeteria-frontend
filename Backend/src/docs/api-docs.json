{
  "openapi": "3.0.0",
  "info": {
    "title": "Smart Cafeteria Ordering System API",
    "version": "1.0.0",
    "description": "Backend API JSON specification"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "responses": {
          "200": { "description": "Login successful" }
        }
      }
    },
    "/menu": {
      "get": {
        "summary": "Get all cafeteria menu items",
        "responses": {
          "200": { "description": "Menu retrieved" }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create a new food order",
        "responses": {
          "201": { "description": "Order successfully generated" }
        }
      }
    }
  }
}