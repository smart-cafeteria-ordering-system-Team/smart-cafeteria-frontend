# Chapa API public key (get from https://dashboard.chapa.co/dashboard/profile/profile/api)
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-SalpxE5d7Qu2l7gROHKwCRQwwapwgZ7
# Chapa API secret key (get from https://dashboard.chapa.co/dashboard/profile/profile/api - must be revealed to copy)
CHAPA_SECRET_KEY=CHASECK_TEST-VOsIXBW26DEMsxpUkwwb1eQMZSHZXujQ
# Chapa encryption key (optional, get from https://dashboard.chapa.co/dashboard/profile/profile/api)
CHAPA_ENCRYPTION_KEY=WDBmoFRXPwQvkEY5sneBR6rp
# Chapa webhook signing secret (set under Webhooks in your Chapa dashboard)
CHAPA_WEBHOOK_SECRET=whsec_5f4d9e3a2b1c8d7e6f5a4b3c2d1e0f9a
